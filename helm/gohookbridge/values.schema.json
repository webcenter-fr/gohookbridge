{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "internal": {
              "type": "object",
              "properties": { "enabled": { "type": "boolean" } }
            },
            "oidc": {
              "type": "object",
              "properties": {
                "providers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "client_id": { "type": "string" },
                      "client_secret_ref": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "key": { "type": "string" }
                        }
                      },
                      "issuer_url": { "type": "string" },
                      "scopes": { "type": "array", "items": { "type": "string" } },
                      "groups_claim": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
