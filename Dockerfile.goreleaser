# Base image pinned by digest for supply-chain integrity (SEC-016).
# Refresh with: docker buildx imagetools inspect registry.access.redhat.com/ubi9/ubi-minimal
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:8ebe2ad8fdf3cab3e5a53c1edc69194c98209cfadab24b884f4ad9ebcf7bbbfc
RUN microdnf -y update && microdnf -y --nodirs install tar rsync shadow-utils && microdnf clean all && useradd gohookbridge && rm -rf /var/cache/yum
COPY gohookbridge /usr/local/bin/gohookbridge
WORKDIR /home/gohookbridge
USER 1001
ENTRYPOINT ["/usr/local/bin/gohookbridge"]