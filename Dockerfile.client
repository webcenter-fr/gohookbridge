# Defaults so the Dockerfile also builds under plain BuildKit/Dagger without
# buildx's automatic platform args (buildx overrides these anyway).
ARG BUILDPLATFORM=linux/amd64

FROM --platform=$BUILDPLATFORM golang:1.27 AS builder
COPY . /go/src/github.com/webcenter-fr/gohookbridge
WORKDIR /go/src/github.com/webcenter-fr/gohookbridge
ARG TARGETARCH=amd64
ARG VERSION=dev
# Inject the resolved version into the embedded version file so the binary's
# --version reports the exact image tag (mirrors the goreleaser hook).
RUN printf '%s' "$VERSION" > /go/src/github.com/webcenter-fr/gohookbridge/internal/app/templates/version
RUN GOFLAGS="-buildvcs=false" CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -a -ldflags="-s -w" -installsuffix cgo -o /tmp/gohookbridge-client ./cmd/gohookbridge-client

FROM registry.access.redhat.com/ubi9/ubi-minimal
RUN microdnf -y update && microdnf -y --nodocs install shadow-utils && microdnf clean all && useradd gohookbridge && rm -rf /var/cache/yum

COPY --from=builder /tmp/gohookbridge-client /usr/local/bin/gohookbridge-client

WORKDIR /home/gohookbridge
USER 1001
ENTRYPOINT ["/usr/local/bin/gohookbridge-client"]
